{
  "name": "bot-famille",
  "version": "1.0.0",
  "description": "Bot Discord générique pour organisation RP FiveM illégale — stocks, quotas, braquages, cooldowns, taxes, armurerie, ventes, fourrière, entièrement configurable depuis Discord",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "discord.js": "^14.16.3",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^20.16.11",
    "@types/node-cron": "^3.0.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
