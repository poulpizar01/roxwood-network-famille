TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=your_guild_id_here

# PostgreSQL — voir README pour la mise en place (locale, hébergée, ou via docker-compose)
DATABASE_URL=postgresql://user:password@localhost:5432/bot_famille

# Uniquement utilisées par docker-compose (service "db") — ignorées en dehors de Docker.
POSTGRES_USER=bot_famille
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bot_famille
