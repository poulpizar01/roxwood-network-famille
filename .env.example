TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=your_guild_id_here

# PostgreSQL — voir README pour la mise en place (locale, hébergée, ou via docker-compose)
DATABASE_URL=postgresql://user:password@localhost:5432/bot_famille

# Uniquement utilisées par docker-compose (service "db") — ignorées en dehors de Docker.
POSTGRES_USER=bot_famille
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bot_famille

# API REST en lecture seule (voir README, section Interopérabilité) — omettre
# API_PORT désactive complètement l'API, aucune autre variable ci-dessous
# n'est alors nécessaire.
API_PORT=3001
# Secret de l'appli Discord (Developer Portal > OAuth2), PAS le TOKEN du bot.
DISCORD_CLIENT_SECRET=your_discord_oauth2_client_secret_here
# Secret de signature des tokens émis par l'API — long, aléatoire, jamais partagé.
API_JWT_SECRET=change_me_to_a_long_random_string
# URL publique de CETTE API (sans slash final) — doit correspondre EXACTEMENT
# à une redirect URI enregistrée dans Discord Developer Portal > OAuth2
# (ex. https://api.example.com, ou http://localhost:3001 en dev).
API_BASE_URL=http://localhost:3001
# URL du site externe vers laquelle rediriger après connexion réussie (le
# token y est transmis en fragment d'URL, #token=...).
FRONTEND_URL=http://localhost:5173
# Origine autorisée en CORS pour les appels fetch() du site externe vers /api/*.
API_CORS_ORIGIN=http://localhost:5173
