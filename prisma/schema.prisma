// Schéma Prisma / PostgreSQL du bot.
//
// Convention : les timestamps métier (mouvements, échéances, cooldowns...)
// sont des `DateTime` Postgres (TIMESTAMPTZ), pas des entiers millisecondes
// bruts — plus idiomatique côté Postgres/Prisma. La couche src/db.ts est la
// SEULE à convertir entre `Date` et millisecondes (Date.now()/getTime()) ;
// tout le reste du bot manipule des nombres, comme avec l'ancien SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══ CONFIGURATION (pilotée par /config, lue par src/config-store.ts) ═══

/// Scalaires de config (salaire par vente, plafonds munitions, amende
/// fourrière...) — pas de table dédiée pour une poignée de nombres nommés.
/// Les salons et rôles Discord, eux, ont leurs propres tables ci-dessous
/// (Channel/DiscordRole) plutôt que ce KV générique : un salon comme
/// `logs_coffres` peut désigner plusieurs salons à la fois, ce qu'une simple
/// paire clé/valeur ne représente pas proprement.
model Setting {
  key   String @id
  value String

  @@map("settings")
}

/// Association rôle fonctionnel du bot → salon(s) Discord, pilotée par
/// `/config channel`. Une ligne par salon assigné à un rôle : la plupart des
/// rôles (stock_general, quotas, armurerie...) n'ont qu'une seule ligne,
/// mais `logs_coffres` peut en avoir plusieurs (tous les salons de logs de
/// coffre surveillés) — même table, pas de cas spécial.
model Channel {
  role      String
  channelId String @map("channel_id")

  @@id([role, channelId])
  @@map("channels")
}

/// Association usage du bot → rôle Discord ('admin' : commandes sensibles ;
/// 'taxes' : accès back-office taxes), pilotée par `/config role`.
model DiscordRole {
  target String @id
  roleId String @map("role_id")

  @@map("discord_roles")
}

/// Items de coffre suivis. Le nom doit correspondre exactement (accents,
/// casse) à ce qu'écrit le bot de jeu FiveM dans les logs de coffre — voir
/// /config item add. stockGroup fusionne plusieurs items sous un même
/// libellé dans le message de stock (ex. "Drogue à vendre"). vente =
/// déclarable en vente PNJ (retrait qui ouvre une vente en attente, voir
/// modules/ventes.ts). Pas de flag équivalent pour la confirmation du
/// paiement : un seul item joue ce rôle en pratique ("Argent Sale"), fixé en
/// dur dans modules/ventes.ts (`CONFIRME_VENTE_ITEM`, même principe que
/// `MUNITIONS_STOCK_GROUP` dans armurerie.ts) plutôt qu'un flag par item.
/// visibleStock : l'item reste suivi (stock à jour, historique) même à
/// `false` — seul son affichage dans le message "Stock Général" est masqué.
/// laboLie : clé d'une activité "labo" (ex. "labo_cocaine", voir
/// ACTIVITY_TYPES_FIXED dans config-store.ts) si cet item est LA drogue que
/// ce labo produit. Sert uniquement à dériver, par tier d'organisation,
/// l'exclusion de vente_pnj : une drogue que le tier courant peut produire
/// lui-même (labo actif pour ce tier, voir LABO_TIERS) n'est pas vendable en
/// PNJ à ce tier — vente_pnj reste sinon tel que configuré ici. `null` pour
/// un item sans lien avec un labo (jamais exclu).
model Item {
  name          String  @id
  stockGroup    String? @map("stock_group")
  vente         Boolean @default(false)
  displayOrder  Int     @default(0) @map("display_order")
  visibleStock  Boolean @default(true) @map("visible_stock")
  laboLie       String? @map("labo_lie")

  @@map("items")
}

/// Objectif hebdomadaire par catégorie de quota. Une catégorie sans ligne
/// ici est suivie mais sans objectif affiché/alerté.
model QuotaTarget {
  quotaType    String @id @map("quota_type")
  weeklyTarget Int    @map("weekly_target")

  @@map("quota_targets")
}

/// Taux de paie ($ par unité) pour une catégorie de quota. Une catégorie sans
/// ligne ici ne génère aucune paie — voir `computeSalaire` dans
/// src/modules/quotas.ts. Indépendant de QuotaTarget : une catégorie peut
/// avoir un objectif sans taux de paie, un taux sans objectif, ou les deux.
model SalaryRate {
  quotaType String @id @map("quota_type")
  amount    Float

  @@map("salary_rates")
}

// ═══ DONNÉES MÉTIER (génériques, indépendantes de la config ci-dessus) ═══

/// Stock total, tous coffres suivis confondus (`/config channel add-log-coffre`)
/// — c'est celui qu'affiche le panneau "Stock Général". Voir {@link
/// CoffreStock} pour le détail par coffre (salon de log), suivi séparément
/// depuis la mise en place de l'API (voir README, section Interopérabilité).
model Stock {
  item     String @id
  quantite Int    @default(0)

  @@map("stocks")
}

/// Stock détaillé PAR coffre (un salon `logs_coffres`) — complément de
/// {@link Stock} (le total global), pas un remplacement : les deux sont mis à
/// jour ensemble à chaque mouvement (voir `stocks.ts`, `applyCoffreStockDelta`
/// aux côtés de `applyStockDelta`). Vidé et reconstruit lors d'un `/sync-stock`
/// complet, comme `Stock`.
model CoffreStock {
  channelId String @map("channel_id")
  item      String
  quantite  Int    @default(0)

  @@id([channelId, item])
  @@map("coffre_stocks")
}

model StockHistory {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime @default(now())
  joueur     String
  action     String
  item       String
  quantite   Int
  stockAvant Int      @map("stock_avant")
  stockApres Int      @map("stock_apres")
  /// Salon `logs_coffres` d'origine du mouvement — `null` pour les lignes
  /// enregistrées avant l'ajout de ce suivi par coffre (jamais backfillé).
  channelId  String?  @map("channel_id")

  @@index([item])
  @@map("stock_history")
}

model Transaction {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id")
  username     String   @default("")
  action       String
  quantite     Float    @default(0)
  type         String?
  partenaires  String   @default("[]")
  tempsRestant String?  @map("temps_restant")
  timestamp    DateTime @default(now())
  deleted      Boolean  @default(false)
  deletedBy    String?  @map("deleted_by")

  @@index([action])
  @@index([timestamp])
  @@map("transactions")
}

model Stat {
  userId String @map("user_id")
  action String
  count  Float  @default(0)
  points Float  @default(0)

  @@id([userId, action])
  @@map("stats")
}

model Cooldown {
  userId    String   @map("user_id")
  action    String
  expiresAt DateTime @map("expires_at")
  notified  Boolean  @default(false)

  @@id([userId, action])
  @@map("cooldowns")
}

/// Fenêtre glissante de 7 jours sur les actions de braquage.
model Braquage {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  action    String
  timestamp DateTime @default(now())

  @@index([action, timestamp])
  @@map("braquages")
}

model Taxe {
  id          Int      @id @default(autoincrement())
  nom         String
  /// Type fixe ('sporex', 'heroine', 'vente', 'fertilisant') OU, pour une
  /// taxe de zone, le nom exact de la zone (ex. 'Roxwood Village') — le
  /// regroupement par zone se fait uniquement via ce champ, pas de colonne
  /// séparée. Voir ZONES dans src/modules/taxes.ts.
  type        String
  telephone   String?
  echeance    DateTime
  motDePasse  String?  @map("mot_de_passe")
  actif       Boolean  @default(true)
  alerteSent  Boolean  @default(false) @map("alerte_sent")
  paye        Boolean  @default(true)

  @@map("taxes")
}

model Arme {
  id        Int     @id @default(autoincrement())
  nom       String
  reference String  @unique
  statut    String  @default("en_stock")
  preteeA   String? @map("pretee_a")
  type      String?

  @@map("armurerie")
}

model UserMapping {
  gameName  String @map("game_name")
  discordId String @map("discord_id")

  @@id([gameName, discordId])
  @@map("user_mapping")
}

model PendingSale {
  id         Int      @id @default(autoincrement())
  joueur     String
  discordId  String?  @map("discord_id")
  item       String
  quantite   Int
  timestamp  DateTime @default(now())
  statut     String   @default("en_attente")
  montant    Int?
  prixPochon Float?   @map("prix_pochon")
  messageId  String?  @map("message_id")
  channelId  String?  @map("channel_id")
  confirmed  Boolean  @default(false)

  @@map("pending_sales")
}

/// État courant de chaque véhicule : qui l'a sorti en dernier, du garage ou
/// de la fourrière. Un rangement propre efface le responsable (discordId/
/// joueur = null). Alimenté par modules/garages.ts depuis logs_garages.
model Vehicule {
  plaque    String   @id
  modele    String?
  discordId String?  @map("discord_id")
  joueur    String?
  timestamp DateTime @default(now())

  @@map("vehicules")
}

/// Historique des mises en fourrière facturées, imputées au dernier
/// responsable connu du véhicule.
model Fourriere {
  id        Int      @id @default(autoincrement())
  discordId String?  @map("discord_id")
  joueur    String
  plaque    String
  modele    String?
  timestamp DateTime @default(now())

  @@map("fourrieres")
}

/// Déclarations de vente de munitions (suivi indicatif — modules/armurerie.ts).
model MunitionVente {
  id              Int      @id @default(autoincrement())
  timestamp       DateTime @default(now())
  vendeurId       String   @map("vendeur_id")
  vendeurUsername String   @default("") @map("vendeur_username")
  acheteurId      String   @map("acheteur_id")
  quantite        Int
  prix            Float

  @@map("munitions_ventes")
}
